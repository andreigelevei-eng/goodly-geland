---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  keywords?: string[];
}

const { title, description, canonical, robots = 'index, follow', keywords = [] } = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).toString();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">Обзорник</a>
      <nav>
        <a href="/products/">Продукты</a>
        <a href="/articles/">Статьи</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Обзорник — обзоры обучающих материалов. Подробные условия покупки доступны на страницах продуктов.</p>
    </footer>
  </body>
</html>
